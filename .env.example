# Copy to .env and adjust. Every value has a safe default for the offline demo.

# SQLite for local dev; point at Supabase/Postgres in production:
#   postgresql+psycopg://user:pass@db.<project>.supabase.co:5432/postgres
FIELD_INTEL_DATABASE_URL=sqlite:///./data/local/field_intel.db

# fake | anthropic | openai. Comma-separate for fallback order, e.g. "anthropic,openai,fake".
FIELD_INTEL_LLM_PROVIDERS=fake
FIELD_INTEL_ANTHROPIC_API_KEY=
FIELD_INTEL_ANTHROPIC_MODEL=claude-sonnet-4-20250514
FIELD_INTEL_OPENAI_API_KEY=
FIELD_INTEL_OPENAI_MODEL=gpt-4o-mini

# Agent limits
FIELD_INTEL_AGENT_MAX_STEPS=6
FIELD_INTEL_TOOL_RESULT_MAX_CHARS=6000

# API keys -> roles. Format: key:role[,key:role]. Roles: grower | operator.
FIELD_INTEL_API_KEYS=dev-grower-key:grower,dev-operator-key:operator

# NDVI below this (field mean) is flagged as stressed
FIELD_INTEL_STRESS_NDVI_THRESHOLD=0.35
